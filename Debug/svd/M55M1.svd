                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>KBKDF (NIST SP 800-108)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>KEYINSEL</name>
