                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Case 1 is out of range</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>C1BRT</name>
              <description>Case 1 Path Best Round bnTimes\nThe field indicates the best round times of bit width detection.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
