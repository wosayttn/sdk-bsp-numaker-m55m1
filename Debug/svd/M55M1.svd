       <register>
          <name>CCAP_MDCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>CCAP_MDCTL</displayName>
          <description>Motion Detection Control Register</description>
          <addressOffset>0x100</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WEN0</name>
              <description>Motion Detection Window 0 Enable Bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Motion Detection Window 0 Disabled</description>
                    <value>00</value>
                 </enumeratedValue>
                 <enumeratedValue>
