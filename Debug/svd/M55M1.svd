        <size>0x18</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0xA0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x100</offset>
        <size>0x4C</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x300</offset>
        <size>0x1B8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x4F8</offset>
        <size>0xB0</size>
        <usage>registers</usage>
      </addressBlock>
