              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>KEYIN from KDF_KEYIN register</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>KEYIN from NVM (Flash)</description>
                    <value>#01</value>
                 </enumeratedValue>
              </enumeratedValues>
