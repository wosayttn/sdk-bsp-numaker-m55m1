       <register>
          <name>LPGPIO_DOUT</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LPGPIO_DOUT</displayName>
          <description>LPIOn Data Output Value</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>DOUT0</name>
              <description>LPIOn Output Value\nEach of these bits controls the status of a LPIOn pin when the LPIOn is configured as Push-pull output mode.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LPIOn will drive Low if the LPIOn pin is configured as Push-pull output mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>LPIOn will drive High if the LPIOn pin is configured as Push-pull output mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
