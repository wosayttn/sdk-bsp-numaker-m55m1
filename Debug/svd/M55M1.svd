          <addressOffset>0x1178</addressOffset>
       </register>
       <register>
          <name>GDMA_CH0_WRKREGPTR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_WRKREGPTR</displayName>
          <description>GDMA Channel Working Register Pointer Register</description>
          <addressOffset>0x1088</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WRKREGPTR</name>
              <description>Internal Working Register Pointer\nThese pointer refers to the following:\nNote: When the selected register is not supported by the DMA then it is read as 0 in the CH_WRKREGVAL register. For 1D modes the INITIAL and LINEINITIAL registers contain the same values.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Reserved.</description>
                    <value>0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SRCADDR_INITIAL</description>
                    <value>1</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>SRCADDRHI_INITIAL</description>
                    <value>2</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>DESADDR_INITIAL</description>
                    <value>3</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>DESADDRHI_INITIAL</description>
                    <value>4</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>SRCXSIZEHI_INITIAL, SRCXSIZE_INITIAL</description>
                    <value>5</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>6</name>
                    <description>DESXSIZEHI_INITIAL, DESXSIZE_INITIAL</description>
                    <value>6</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>7</name>
                    <description>SRCADDR_LINEINITIAL</description>
                    <value>7</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>8</name>
                    <description>SRCADDRHI_LINEINITIAL</description>
                    <value>8</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>9</name>
                    <description>DESADDR_LINEINITIAL</description>
                    <value>9</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>10</name>
                    <description>DESADDRHI_LINEINITIAL</description>
                    <value>10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>11</name>
                    <description>SRCYSIZE_INITIAL (HAS_2D only)</description>
                    <value>11</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>12</name>
                    <description>DESYSIZE_INITIAL (HAS_2D only)</description>
                    <value>12</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
