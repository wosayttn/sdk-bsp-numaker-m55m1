       <register>
          <name>GDMA_CH0_ERRINFO</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_ERRINFO</displayName>
          <description>GDMA Channel Error Information Register</description>
          <addressOffset>0x1090</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BUSERR</name>
              <description>Bus Error Flag\nSet when the DMA encounters a bus error during data or command read transfers.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CFGERR</name>
              <description>Configuration Error Flag\nSet when the DMA command is enabled or a linked command is read but it is configured in a mode that is not supported by the implementation.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SRCTRIGINSELERR</name>
              <description>Source Trigger Input Selection Error Flag\nSet when the command selects a source trigger input that is not allowed for this channel.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>DESTRIGINSELERR</name>
              <description>Destination Trigger Input Selection Error Flag\nSet when the command selects a destination trigger input that is not allowed for this channel.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>TRIGOUTSELERR</name>
              <description>Trigger Output Selection Error Flag\nSet when the command selects a trigger output that is not allowed for this channel</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>STREAMERR</name>
              <description>Stream Interface Error Flag\nSet when the stream interface encountered an error. The field is RAZ/WI when the following condition is False: CH_STREAM_EN</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>ERRINFO</name>
              <description>Error information Register\nAdditional information for the error that is encountered by the DMA. The meaning of the bits are detailed in the Error Handling section.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register derivedFrom="GDMA_CH0_ERRINFO">
