            <field>
              <name>CAP2RLDEN</name>
              <description>Capture Counter's Reload Function Triggered by Event CAPTE2 Enable Bit</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
