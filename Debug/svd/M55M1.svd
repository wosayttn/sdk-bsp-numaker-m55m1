            <field>
              <name>BP</name>
              <description>APLL0 Bypass Control\nNote: This bit is not retained when D2 power is turned off.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>APLL0 is in normal mode (default)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>APLL0 clock output is same as APLL0 input clock FIN</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PLLFEN</name>
              <description>APLL0 Clock Filter Enable Bit\nNote: This bit is not retained when D2 power is turned off.</description>
