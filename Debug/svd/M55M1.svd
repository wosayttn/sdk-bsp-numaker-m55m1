       <register>
          <name>GDMA_CH0_AUTOCFG</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_AUTOCFG</displayName>
          <description>GDMA Channel Automatic Command Restart Configuration Register</description>
          <addressOffset>0x1074</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CMDRESTARTCNT</name>
              <description>Automatic Command Restart Counter</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CMDRESTARTINFEN</name>
              <description>Enable Infinite Automatic Command Restart\nWhen set, CMDRESTARTCNT is ignored and the command is always restarted after it is completed, including output triggering if enabled and autoreloading the registers but it will not perform a link to the next command. This means that the infinite loop of automatic restarts can only be broken by DISABLECMD or STOPCMD. When CMDRESTARTINFEN is set to '0', then the autorestarting of a command depends on CMDRESTARTCNT and when that counter is set to 0 the autorestarting is finished. In this case the next linked command is read or the command is complete</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register derivedFrom="GDMA_CH0_AUTOCFG">
          <name>GDMA_CH1_AUTOCFG</name>
          <displayName>GDMA_CH1_AUTOCFG</displayName>
          <description>GDMA Channel Automatic Command Restart Configuration Register</description>
          <addressOffset>0x1174</addressOffset>
       </register>
       <register>
          <name>GDMA_CH0_LINKADDR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_LINKADDR</displayName>
          <description>GDMA Channel Link Address Register</description>
          <addressOffset>0x1078</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LINKADDRREN</name>
              <description>Enable Link Address\nNote: the linked command fetched by the DMAC needs to clear this field to mark the end of the command chain. Otherwise it may result in an infinite loop of the same command</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The DMAC will return to idle at the end of the current command</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The DMAC fetches the next command defined by LINKADDR</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>LINKADDR</name>
              <description>Link Address Pointer[31:2]\nThe DMAC fetches the next command from this address if LINKADDREN is set. Note: Commands are fetched with the security and privilege attribute of the channel and cannot be adjusted for the command link reads.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
