                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Finish generating the next partial key</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
