              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Secure</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Non-secure When a channel is Non-secure this bit is tied to 1</description>
