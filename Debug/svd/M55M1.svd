              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>The reload triggered by Event CAPTE0 Disabled</description>
                    <value>#0</value>
