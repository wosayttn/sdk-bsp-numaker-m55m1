<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" >
  <name>M55M1</name>
  <version>1.0</version>
  <description>M55M1 SVD file</description>
  <!-- Bus Interface Properties -->
  <!-- Cortex-M0 is byte addressable -->
  <addressUnitBits>8</addressUnitBits>
  <!-- the maximum data bit width accessible within a single transfer is 32bits -->
  <width>32</width>

  <!-- Register Default Properties -->
  <!-- the size of the registers is set to a bit width of 32. This can be overruled for individual peripherals and/or registers -->
  <size>32</size>
  <!-- the access to all registers is set to be readable and writeable. This can be overruled for individual peripherals and/or registers -->
  <access>read-write</access>
  <!-- for demonstration purposes the resetValue for all registers of the device is set to be 0. This can be overruled within the description -->
  <resetValue>0</resetValue>
  <!-- the resetMask = 0 specifies that by default no register of this device has a defined reset value -->
  <resetMask>0</resetMask>

  <peripherals>
    <peripheral>
      <name>SCS</name>
      <description>SCR Register Map</description>
      <groupName>SCR</groupName>
      <baseAddress>0xE000E000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0xDD0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>SAU_CTRL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SAU_CTRL</displayName>
          <description>SAU Control Register</description>
          <addressOffset>0xDD0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>SAU Enable Bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>SAU Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>SAU Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>ALLNS</name>
              <description>All Non-secure</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>All Memory region is marked as Secure and is not Non-secure callable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>All Memory region is marked as Non-secure by SAU, indicating the security attribute of all memory is defined by IDAU</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SAU_TYPE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SAU_TYPE</displayName>
          <description>SAU Type Register</description>
          <addressOffset>0xDD4</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SREGION</name>
              <description>SAU Regions\nIndicates the number of regions implemented by the Security Attribution Unit.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SAU_RNR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SAU_RNR</displayName>
          <description>SAU Region Number Register</description>
          <addressOffset>0xDD8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFF00</resetMask>
          <fields>
            <field>
              <name>REGION</name>
              <description>Current Region of SAU\nIndicates the SAU region accessed by SAU_RBAR and SAU_RLAR.\nSet a value to select the region to be configure through SAU_RBAR and SAU_RLAR.\nIt can be set to 0 ~ the value of SAU_TYPE -1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SAU_RBAR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SAU_RBAR</displayName>
          <description>SAU Region Base Address Register</description>
          <addressOffset>0xDDC</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>
          <fields>
            <field>
              <name>BADDR</name>
              <description>Base Address of Currently Selected Region\nThe base address of the region selected by SAU_RNR.\nSAU region is 32-byte-aligned.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>SAU_RLAR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SAU_RLAR</displayName>
          <description>SAU Region Limit Address Register</description>
          <addressOffset>0xDE0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>RENABLE</name>
              <description>Region Enable Bit\nEnable or disable the currently selected region set by SAU_RNR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Disabled selected region set by SAU_RNR</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Enabled selected region set by SAU_RNR</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>NSC</name>
              <description>Non-secure Callable Setting Bit\nControls whether Non-secure state is permitted to execute an SG instruction\nfrom this region.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Region is not Non-secure callable. If RENABLE =1, the current region is Non-secure</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Region is Non-secure callable. If RENABLE=1, the current region is Secure and Non-secure callable</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>LADDR</name>
              <description>Limit Address of Currently Selected Region\nThe limited address of the region selected by SAU_RNR.\nThe region of the selected SAU region is [SAU_RBAR.BADDR,5'b00000] ~ [LADDR,5'b11111]</description>
              <bitOffset>5</bitOffset>
              <bitWidth>27</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PMC</name>
      <description>PMC Register Map</description>
      <groupName>PMC</groupName>
      <baseAddress>0x40002000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0xC</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x10</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x20</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x28</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x30</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x50</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x60</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x100</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x124</offset>
        <size>0x8</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x140</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>PMC_PWRCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_PWRCTL</displayName>
          <description>System Power-down Control Register</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00001100</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>D0PGEN</name>
              <description>Power Domain 0 Power Gating Enable Bit (Write Protect)\nThis bit control power domain 0 (Performance Domain) power gating function when system enter Power-down mode(CPU execute WFI/WFE instruction and SLEEPDEEP(SCR[2]) is 1).\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power domain 0 keep supply</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power domain 0 stop supply</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>D1PGEN</name>
              <description>Power Domain 1 Power Gating Enable Bit (Write Protect)\nThis bit control power domain 1 (Base Domain) power gating function when system enter Power-down mode(CPU execute WFI/WFE instruction and SLEEPDEEP(SCR[2]) is 1).\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: If D0PGEN(PMC_PWRCTL[0]) is 0, The power domain 1 always keep supply, even if D1PGEN is 1.\nNote 4: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power domain 1 keep supply</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power domain 1 stop supply</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>D2PGEN</name>
              <description>Power Domain 2 Power Gating Enable Bit (Write Protect)\nThis bit control power domain 2 (Low Power Domain) power gating function when system enter Power-down mode(CPU execute WFI/WFE instruction and SLEEPDEEP(SCR[2]) is 1).\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: If D1PGEN(PMC_PWRCTL[1]) is 0, The power domain 2 always keep supply, even if D2PGEN is 1.\nNote 4: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power domain 2 keep supply</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power domain 2 stop supply</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>D3PGEN</name>
              <description>Power Domain 3 Power Gating Enable Bit (Write Protect)\nThis bit control power domain 3 (Standby Power Domain) power gating function when system enter Power-down mode(CPU execute WFI/WFE instruction and SLEEPDEEP(SCR[2]) is 1).\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: If D2PGEN(PMC_PWRCTL[2]) is 0, The power domain 3 always keep supply, even if D3PGEN is 1.\nNote 4: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power domain 3 keep supply</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power domain 3 stop supply</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>AOCKPDEN</name>
              <description>Auto Operation Mode Clock Power-down Enable (Write Protect)\nWhen this bit is set to 1, Auto Operation Mode clock Power-down mode is enabled and MIRC and HIRC keeps active till the chip enter Power-down mode.\nIf chip in Power-down mode, HXT, HIRC48M, APLL0, APLL1 and system clock will be disabled and ignored the clock source selection. The clocks of peripheral are not controlled by Power-down mode, if the peripheral clock source is from LXT, LIRC, MIRC or HIRC.\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: This bit is not retained when D2 power is turned off.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>MIRC and HIRC enable in Power-down mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>MIRC and HIRC disable in Power-down mode under normal circumstances, but MIRC and HIRC will be enable via a trigger from auto operation mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>VDROPEN</name>
              <description>Voltage Regulator Output Drop Enable Bit (Write Protect)\nWhen this bit is set to 1, voltage regulator output drop to 0.7v in Power-down mode. \nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Regulator voltage auto drop function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Regulator voltage auto drop function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>FWEN</name>
              <description>Fast Wake-up Enable Bit (Write Protect)\nWhen this bit is set to 1, wake-up will be speed up, but power consumption is increase about 30uA in Power-down mode. \nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Regulator voltage auto drop function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Regulator voltage auto drop function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PRSTDBEN</name>
              <description>Pin Reset De-Bounce Enable Bit (Write Protect)\nWhen this bit is set to 1, pin reset clock base de-bounce circuit is enable in Power-down mode. \nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: This bit is not retained when D2 power is turned off.\nNote 3: If D2PGEN(PMC_PWRCTL[2]) is 1, The pin reset de-bounce circuit always keep disable, even if PRSTDBEN is 1.\nNote 4: If VDROPEN(PMC_PWRCTL[10]) is 1, The pin reset de-bounce circuit always keep disable, even if PRSTDBEN is 1.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin reset de-bounce circuit Disable, and de-bounce time about 300ns</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin reset de-bounce circuit Enable, and de-bounce time about 32us</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>WRBUSY</name>
              <description>Write Busy Flag (Read Only)\nIf PMC_PWRCTL is written, this bit is asserted automatically by hardware, and is de-asserted when write procedure is finished.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PMC_PWRCTL register is ready for write operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PMC_PWRCTL register is busy on the last write operation. Other write operations are  ignored</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_INTEN</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_INTEN</displayName>
          <description>PMC Interrupt Enable Register</description>
          <addressOffset>0x4</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PDWKIEN</name>
              <description>Power-down Mode Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PDWKIF(PMC_INTSTS[0] and PDWKIEN(PMC_INTEN[0]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power-down mode wake-up interrupt Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power-down mode wake-up interrupt Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>STMRWKIEN</name>
              <description>Standby Timer Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both STMRWKIF(PMC_INTSTS[1] and STMRWKIEN(PMC_INTEN[1]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>High Voltage Timer wake-up interrupt disable</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>High Voltage Timer wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN0WKIEN</name>
              <description>Pin 0 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN0WKIF(PMC_INTSTS[8] and PIN0WKIEN(PMC_INTEN[8]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 0 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 0 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN1WKIEN</name>
              <description>Pin 1 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN1WKIF(PMC_INTSTS[9] and PIN1WKIEN(PMC_INTEN[9]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 1 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 1 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN2WKIEN</name>
              <description>Pin 2 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN2WKIF(PMC_INTSTS[10] and PIN2WKIEN(PMC_INTEN[10]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 2 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 2 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN3WKIEN</name>
              <description>Pin 3 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN3WKIF(PMC_INTSTS[11] and PIN3WKIEN(PMC_INTEN[11]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 3 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 3 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN4WKIEN</name>
              <description>Pin 4 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN4WKIF(PMC_INTSTS[12] and PIN4WKIEN(PMC_INTEN[12]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 4 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 4 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN5WKIEN</name>
              <description>Pin 5 Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both PIN4WKIF(PMC_INTSTS[13] and PIN4WKIEN(PMC_INTEN[13]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D4 power is turned off.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Pin 5 wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Pin 5 wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>GPATGWKIEN</name>
              <description>GPA Trigger Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both GPATGWKIF(PMC_INTSTS[16] and GPATGWKIEN(PMC_INTEN[16]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPA triggrer wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPA triggrer wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>GPBTGWKIEN</name>
              <description>GPB Trigger Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both GPBTGWKIF(PMC_INTSTS[17] and GPBTGWKIEN(PMC_INTEN[17]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPB triggrer wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPB triggrer wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>GPCTGWKIEN</name>
              <description>GPC Trigger Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both GPCTGWKIF(PMC_INTSTS[18] and GPCTGWKIEN(PMC_INTEN[18]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPC triggrer wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPC triggrer wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>GPDTGWKIEN</name>
              <description>GPD Trigger Wake-up Interrupt Enable Bit (Write Protect)\nNote 1: The PMC interrupt will occur when both GPDTGWKIF(PMC_INTSTS[19] and GPDTGWKIEN(PMC_INTEN[19]) are 1.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPD triggrer wake-up interrupt disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPD triggrer wake-up interrupt enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_INTSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_INTSTS</displayName>
          <description>PMC Interrupt Status Register</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PDWKIF</name>
              <description>Power-down Mode Wake-up Interrupt Status\nSet by 'Power-down wake-up event', it indicates that resume from Power-down mode. \nThe flag is set if any wake-up source occurred. Refer Power Modes and Wake-up Sources chapter.\nNote 1: The PMC interrupt will occur when both PDWKIF(PMC_INTSTS[0] and PDWKIEN(PMC_INTEN[0]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STMRWKIF</name>
              <description>Standby Timer Wake-up Interrupt Status\nThe flag is set if stadnby timer wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both STMRWKIF(PMC_INTSTS[1] and STMRWKIEN(PMC_INTEN[1]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN0WKIF</name>
              <description>Pin 0 Wake-up Interrupt Status\nThe flag is set if Pin 0 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN0WKIF(PMC_INTSTS[8] and PIN0WKIEN(PMC_INTEN[8]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN1WKIF</name>
              <description>Pin 1 Wake-up Interrupt Status\nThe flag is set if Pin 1 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN1WKIF(PMC_INTSTS[9] and PIN1WKIEN(PMC_INTEN[9]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN2WKIF</name>
              <description>Pin 2 Wake-up Interrupt Status\nThe flag is set if Pin 2 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN2WKIF(PMC_INTSTS[10] and PIN2WKIEN(PMC_INTEN[10]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN3WKIF</name>
              <description>Pin 3 Wake-up Interrupt Status\nThe flag is set if Pin 3 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN3WKIF(PMC_INTSTS[11] and PIN3WKIEN(PMC_INTEN[11]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN4WKIF</name>
              <description>Pin 4 Wake-up Interrupt Status\nThe flag is set if Pin 4 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN4WKIF(PMC_INTSTS[12] and PIN4WKIEN(PMC_INTEN[12]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PIN5WKIF</name>
              <description>Pin 5 Wake-up Interrupt Status\nThe flag is set if Pin 5 wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both PIN4WKIF(PMC_INTSTS[13] and PIN4WKIEN(PMC_INTEN[13]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GPATGWKIF</name>
              <description>GPA Trigger Wake-up Interrupt Status\nThe flag is set if GPA trigger wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both GPATGWKIF(PMC_INTSTS[16] and GPATGWKIEN(PMC_INTEN[16]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GPBTGWKIF</name>
              <description>GPB Trigger Wake-up Interrupt Status\nThe flag is set if GPB trigger wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both GPBTGWKIF(PMC_INTSTS[17] and GPBTGWKIEN(PMC_INTEN[17]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GPCTGWKIF</name>
              <description>GPC Trigger Wake-up Interrupt Status\nThe flag is set if GPC trigger wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both GPCTGWKIF(PMC_INTSTS[18] and GPCTGWKIEN(PMC_INTEN[18]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GPDTGWKIF</name>
              <description>GPC Trigger Wake-up Interrupt Status\nThe flag is set if GPD trigger wake-up event occurred in Power-down mode.\nNote 1: The PMC interrupt will occur when both GPDTGWKIF(PMC_INTSTS[19] and GPDTGWKIEN(PMC_INTEN[19]) are 1.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CLRWK</name>
              <description>Clear Wake-up Flag\nClearing the Wake-up flag is not timely. Flags in PMC_INTSTS will not be immediately  cleared in the next cycle when CLRWK written to 1.\nNote 1: This bit is auto cleared by hardware.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>No clear</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Clear all wake-up flags</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_PLCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_PLCTL</displayName>
          <description>Power Level Control Register</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PLSEL</name>
              <description>Power Level Select (Write Protect)\nNote 1: These bits are write protected. Refer to the SYS_REGLCTL register.\nNote 2: Write operation is ignored when WRBUSY is high.\nNote 3: These bits are not retained when D3 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Set to Power level 0 (PL0)</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Set to Power level 1 (PL1). (default)</description>
                    <value>#01</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>WRBUSY</name>
              <description>Write Busy Flag (Read Only)\nIf PMC_PLCTL is written, this bit is asserted automatically by hardware, and is de-asserted when write procedure is finished.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PMC_PLCTL register is ready for write operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PMC_PLCTL register is busy on the last write operation. Other write operations are ignored</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_PLSTS</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_PLSTS</displayName>
          <description>Power Level Status Register</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>PLSTATUS</name>
              <description>Power Level Status (Read Only)\nThis bit field reflect the current power level.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power level is PL0</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power level is PL1</description>
                    <value>#01</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>PLCBUSY</name>
              <description>Power Level Change Busy Bit (Read Only)\nThis bit is set by hardware when power level is changing. After power level change is completed, this bit will be cleared automatically by hardware.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Power level change is completed</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Power level change is ongoing</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_IOSHCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_IOSHCTL</displayName>
          <description>GPIO Status Hold Control Register</description>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IOHR</name>
              <description>GPIO Hold Release\nNote 1: This bit is auto cleared by hardware.\nNote 2: This bit is not retained when D0 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_BATLDCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_BATLDCTL</displayName>
          <description>Battery Loss Detector Control Register</description>
          <addressOffset>0x28</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BATLDEN</name>
              <description>Battery Loss Detector Enable Bit (Write Protect)\nNote 1: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 2: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Battery Loss Detector Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Battery Loss Detector Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_IOTGDBCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_IOTGDBCTL</displayName>
          <description>GPIO Trigger De-bounce Control Register</description>
          <addressOffset>0x30</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>IOTGDBSEL</name>
              <description>GPIO Trigger Pin De-bounce Sampling Cycle Selection\nNote 1: De-bounce counter clock source is the 32 kHz internal low speed RC oscillator (LIRC).\nNote 2: Write operation is ignored when WRBUSY is high\nNote 3: These bits are not retained when D3 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Sample GPIO input once per 1 clock</description>
                    <value>#0000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Sample GPIO input once per 2 clocks</description>
                    <value>#0001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Sample GPIO input once per 4 clocks</description>
                    <value>#0010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Sample GPIO input once per 8 clocks</description>
                    <value>#0011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>Sample GPIO input once per 16 clocks</description>
                    <value>#0100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>Sample GPIO input once per 32 clocks</description>
                    <value>#0101</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>6</name>
                    <description>Sample GPIO input once per 64 clocks</description>
                    <value>#0110</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>7</name>
                    <description>Sample GPIO input once per 128 clocks</description>
                    <value>#0111</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>8</name>
                    <description>Sample GPIO input once per 256 clocks</description>
                    <value>#1000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>9</name>
                    <description>Sample GPIO input once per 2*256 clocks</description>
                    <value>#1001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>10</name>
                    <description>Sample GPIO input once per 4*256 clocks</description>
                    <value>#1010</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>11</name>
                    <description>Sample GPIO input once per 8*256 clocks</description>
                    <value>#1011</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>12</name>
                    <description>Sample GPIO input once per 16*256 clocks</description>
                    <value>#1100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>13</name>
                    <description>Sample GPIO input once per 32*256 clocks</description>
                    <value>#1101</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>14</name>
                    <description>Sample GPIO input once per 64*256 clocks</description>
                    <value>#1110</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>15</name>
                    <description>Sample GPIO input once per 128*256 clocks</description>
                    <value>#1111</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>WRBUSY</name>
              <description>Write Busy Flag (Read Only)\nIf PMC_IOTGDBCTL is written, this bit is asserted automatically by hardware, and is de-asserted when write procedure is finished.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>PMC_ IOTGDBCTL register is ready for write operation</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>PMC_ IOTGDBCTL register is busy on the last write operation. Other write operations are ignored</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>PMC_GPATGCTL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_GPATGCTL</displayName>
          <description>GPA Trigger Control Register</description>
          <addressOffset>0x34</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>TGPWKEN</name>
              <description>GPA Trigger Pin Wake-up Enable Bit\nNote 1: The GPA Trigger Pin wake-up is always enable when D2PGEN(PMC_PWRCTL[2] is 1.\nNote 2: This bit is not retained when D2 power is turned off.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPA group trigger pin wake-up chip Disabled, trigger ip Enabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPA group trigger pin wake-up chip Enabled, trigger ip Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>TGPREN</name>
              <description>GPA Trigger Pin Rising Edge Enable Bit\nNote 1: Write operation is ignored when WRBUSY is high\nNote 2: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>GPA group trigger pin rising edge trigger function Disabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>GPA group trigger pin rising edge trigger function Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>TGPFEN</name>
              <description>GPA Trigge Pin Falling Edge Enable Bit\nNote 1: Write operation is ignored when WRBUSY is high\nNote 2: This bit is not retained when D3 power is turned off.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
