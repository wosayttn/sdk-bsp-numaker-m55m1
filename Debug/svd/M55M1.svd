              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>NBW</name>
              <description>Narrow Bit Width (Read Only)\nThe field indicates the narrow bit width (based on 12M).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
