                 <enumeratedValue>
                    <name>0</name>
                    <description>Noise filter of Input Capture Enabled</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Noise filter of Input Capture Disabled (Bypass)</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
