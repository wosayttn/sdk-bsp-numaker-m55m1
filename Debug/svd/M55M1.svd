                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>ADCMPF0</description>
                    <value>#0100</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>5</name>
                    <description>ACMP0</description>
