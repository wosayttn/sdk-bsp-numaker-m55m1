                 <enumeratedValue>
                    <name>0</name>
                    <description>Filter clock = PCLK</description>
                    <value>#000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Filter clock = PCLK/2</description>
                    <value>#001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>Filter clock = PCLK/4</description>
                    <value>#010</value>
