       <register>
          <name>UTCPD_C2PRR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>UTCPD_C2PRR</displayName>
          <description>UTCPD Case 2 Path Record Register</description>
          <addressOffset>0x330</addressOffset>
          <access>read-only</access>
          <resetValue>0x00003F00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>C2PWBPN</name>
              <description>Case 2 Path Wide Bit Period Number (Read Only)\nThe field indicates the final width bit clock number based 12M clock.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>C2PNBPN</name>
              <description>Case 2 Path Narrow Bit Period Number (Read Only)\nThe field indicates the final narrow bit clcok number based 12M.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>C2PORF</name>
              <description>Case 2 Path Out of Range Flag\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Case 2 isn't out of range</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Case 2 is out of range</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>C2BRT</name>
              <description>Case 2 Path Best Round Times\nThe field indicates the best round times of bit width detection.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
