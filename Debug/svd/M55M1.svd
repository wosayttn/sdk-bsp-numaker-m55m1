              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DTR_DATA</name>
              <description>Double Transfer Rate Mode Enable Bit for Data Phase\nIn master mode, SPI will receive data at both rising edge and falling edge of SPI bus clock.\nNote: Only used for DMA Write mode.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
