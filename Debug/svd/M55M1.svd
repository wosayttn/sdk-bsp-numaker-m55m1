       <register>
          <name>GDMA_CH0_WRKREGVAL</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_WRKREGVAL</displayName>
          <description>GDMA Channel - Working Register Value Register</description>
          <addressOffset>0x108C</addressOffset>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>WRKREGVAL</name>
              <description>Internal Working Register Values\nWRKREGPTR points to the register that is visible here. The values are only guaranteed to be stable for the current command when STAT_PAUSED is asserted, otherwise they depend on the current status of the channel which makes them UNPREDICTABLE.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
