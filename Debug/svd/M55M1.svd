          <!-- the display name is an unrestricted string. -->
          <displayName>GDMA_CH0_SRCTMPLT</displayName>
          <description>GDMA Channel 0 Source Template Pattern Register</description>
          <addressOffset>0x1044</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SRCTMPLTLSB</name>
              <description>Source Packing Template Least Significant Bit\nThis bit of the template is read only and always set to 1 as template patterns can only start from the base address of the transfer. Not present when HAS_TMPLT is 0. The field is RAZ/WI when the following condition is False: CH_EXT_FEAT_EN</description>
              <bitOffset>0</bitOffset>
