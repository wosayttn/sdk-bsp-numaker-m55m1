              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>STBSEL</name>
              <description>APLL0 Stable Counter Selection\nNote: These bits are not retained when D2 power is turned off.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>APLL0 stable time is 820 APLL0 source clock (source clock is equal to 4M)</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>APLL0 stable time is 2460 APLL0 source clock (4 MHz  source clock &#8804;12 MHz)</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>APLL0 stable time is 4920 APLL0 source clock (12 MHz  source clock &#8804;24 MHz)</description>
