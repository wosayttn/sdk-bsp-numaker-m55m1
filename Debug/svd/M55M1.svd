            <field>
              <name>CONI1SCS</name>
              <description>Configurable Interrupt 1 Slot Controller Selection \nSelect Slot controller for interrupt 1.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
