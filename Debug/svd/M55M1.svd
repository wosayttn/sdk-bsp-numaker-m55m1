       <register>
          <name>SYS_TISTS12M</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>SYS_TISTS12M</displayName>
          <description>HIRC 12M Trim Interrupt Status Register</description>
          <addressOffset>0x128</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FREQLOCK</name>
              <description>HIRC Frequency Lock Status\nThis bit indicates the HIRC frequency is locked.\nThis is a status bit and doesn't trigger any interrupt.\nThis bit will be set automatically, if the frequency is lock and the RC_TRIM is enabled.\nNote: Write 1 to clear this bit to 0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
