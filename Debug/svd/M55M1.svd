          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>LABEL</name>
              <description>Label\nFor RFC 5869, partial info is to be filled in LABEL according to Figure 6.592.\nFor NIST SP 800-108, Label is to be filled in LABEL.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
       </register>
