       </register>
       <register>
          <name>PMC_KSRPC</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>PMC_KSRPC</displayName>
          <description>KS SRAM Power Mode Control Register</description>
          <addressOffset>0x140</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>KSSRPMS</name>
              <description>KS SRAM Power Mode Select (Write Protect)\nThis field can control KS0 SRAM power mode.\nNote 1: Power shut down mode can get least leakage, but don't guarantee the retention of SRAM data.\nNote 2: This bit is write protected. Refer to the SYS_REGLCTL register.\nNote 3: Write operation is ignored when PCBUSY is 1.\nNote 4: If system enter Power-down mode and D3PGEN(PMC_PWRCTL[3]) is set to 1, This SRAM is auto set to power shut down mode by hardware.\nNote 5: These bits are not retained when D3 power is turned off.\nNote 6: This field only reset by POR reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>KS SRAM is normal mode</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>KS SRAM is retention mode</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>KS SRAM is power shut down mode</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Reserved (Write Ignore)</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>PCBUSY</name>
              <description>Power Changing Busy Flag (Read Only)\nIf PMC_KSRPC is written, this bit is asserted automatically by hardware, and is de-asserted when SRAM power change procedure is finished.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
