              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Rx FIFO 1 fill level below watermark</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
