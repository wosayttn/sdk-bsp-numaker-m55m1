                 <enumeratedValue>
                    <name>1</name>
                    <description>Tamper 0 de-bounce Enabled, tamper detection pin will sync 1 RTC counter clock</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
