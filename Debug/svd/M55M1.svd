                    <value>0x3</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>4</name>
                    <description>32 bits</description>
                    <value>0x4</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>DTR_CMD</name>
              <description>Double Transfer Rate Mode Enable Bit for Command Phase\nIn master mode, SPI will transmit data at both rising edge and falling edge of SPI bus clock.\nNote: Only used for DMA Write mode.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>DTR mode Disabled (i.e. Single Transfer Rate (STR) mode enabled)</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>DTR mode Enabled</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
