              <access>read-write</access>
            </field>
            <field>
              <name>AE</name>
              <description>Address Enable\nWhen this bit is set, the address filter module uses the eighth MAC address for perfect filtering. When this bit is reset, the address filter module ignores the address for filtering.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
       </register>
       <register>
          <name>MAC_Address7_Low</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>MAC_Address7_Low</displayName>
          <description>Register 31 (MAC Address7 Low Register)</description>
          <addressOffset>0x7C</addressOffset>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
