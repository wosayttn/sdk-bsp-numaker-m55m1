    <peripheral>
      <name>LPGPIO</name>
      <description>LPGPIO Register Map</description>
      <groupName>LPGPIO</groupName>
      <baseAddress>0x40403000</baseAddress>
      <!-- d -> no access permission -->
      <addressBlock>
        <offset>0x0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
       <register>
          <name>LPGPIO_MODE</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>LPGPIO_MODE</displayName>
          <description>LPIOn Mode Control</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>MODE0</name>
              <description>LPIOn I/O Pin Mode Control\nDetermine each I/O mode of LPIOn pins.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>LPIOn is in Input mode</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>LPIOn is in Push-pull Output mode</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-write</access>
            </field>
            <field>
              <name>MODE1</name>
              <description>LPIOn I/O Pin Mode Control\nDetermine each I/O mode of LPIOn pins.</description>
              <bitOffset>1</bitOffset>
