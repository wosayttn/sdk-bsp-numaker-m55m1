              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>0.84V (Default)</description>
                    <value>#00</value>
                 </enumeratedValue>
