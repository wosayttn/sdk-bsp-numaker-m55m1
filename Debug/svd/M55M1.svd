            <field>
              <name>TXRTRIM</name>
              <description>TX Trim Rising slew rate \nIt is for BMC eye diagram.\nTrim PHY TX Rising slew rate (from ROMMAP)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXFTRIM</name>
