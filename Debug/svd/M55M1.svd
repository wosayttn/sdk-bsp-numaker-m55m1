                    <description>The case 0</description>
                    <value>#00</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>The case 1</description>
                    <value>#01</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>The case 2</description>
                    <value>#10</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>3</name>
                    <description>Reserved.</description>
                    <value>#11</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>UTCPD_C0PRR</name>
          <!-- the display name is an unrestricted string. -->
          <displayName>UTCPD_C0PRR</displayName>
          <description>UTCPD Case 0 Path Record Register</description>
          <addressOffset>0x328</addressOffset>
          <access>read-only</access>
          <resetValue>0x00003F00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>C0PWBPN</name>
              <description>Case 0 Path Wide Bit Period Number (Read Only)\nThe field indicates the final width bit clock number based 12M clock.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>C0PNBPN</name>
              <description>Case 0 Path Narrow Bit Period Number (Read Only)\nThe field indicates the final narrow bit clcok number based 12M. If the RNICHK (UTCPD_PREDET[2:0]) is 3'b000, the default value is 0x3F.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>6</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>C0PORF</name>
              <description>Case 0 Path Out of Range Flag\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>Case 0 isn't out of range</description>
                    <value>#0</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>Case 0 is out of range</description>
                    <value>#1</value>
                 </enumeratedValue>
              </enumeratedValues>
              <access>read-only</access>
            </field>
            <field>
              <name>C0BRT</name>
              <description>Case 0 Path Best Round Times\nThe field indicates the best round times of bit width detection.\nNote: It is cleared in next preamble start or write 1.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
       </register>
       <register>
          <name>UTCPD_C1PRR</name>
