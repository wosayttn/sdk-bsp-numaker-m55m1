              <enumeratedValues>
                 <enumeratedValue>
                    <name>0</name>
                    <description>EINT0</description>
                    <value>#0000</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>1</name>
                    <description>EINT1</description>
                    <value>#0001</value>
                 </enumeratedValue>
                 <enumeratedValue>
                    <name>2</name>
                    <description>EINT2</description>
                    <value>#0010</value>
                 </enumeratedValue>
                 <enumeratedValue>
